# --- Core LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# --- Server ---
PORT=3000
CORS_ORIGIN=*
NODE_ENV=production

# --- Session store (Redis recommended for production; falls back to in-memory) ---
REDIS_URL=redis://localhost:6379

# --- Telegram ---
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=change-me

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=change-me

# --- Facebook Messenger ---
MESSENGER_PAGE_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MESSENGER_VERIFY_TOKEN=change-me
MESSENGER_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
